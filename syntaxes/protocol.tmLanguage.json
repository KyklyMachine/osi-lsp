{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Protocol Language",
  "scopeName": "source.protocol",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#handlers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#events"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.protocol",
          "match": ";.*$"
        }
      ]
    },
    "handlers": {
      "patterns": [
        {
          "name": "entity.name.function.handler.protocol",
          "match": "^##\\s+([A-Z_][A-Z0-9_\\.\\-]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.protocol"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.protocol",
          "match": "\\b(goto|if|return|subprog|substart|subend)\\b"
        },
        {
          "name": "keyword.other.protocol",
          "match": "\\b(declare|varset|out|delete)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.protocol",
          "match": "\\b(bufferit|unbufferit|calccrc|timer|untimer|queue|clearqueue|dequeue|peek|qcount|generateup|eventdown)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.protocol",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.comparison.protocol",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.logical.protocol",
          "match": "(&&|\\|\\|)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.protocol",
          "match": "\\b(integer|buffer|string|queue)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.protocol",
          "match": "\\b(sizeof|copy|pos|locguide|CurrentSystemName)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.protocol",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.protocol",
              "match": "\\\\(n|t|r|\\\\|\")"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.protocol",
          "match": "\\b-?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.charcode.protocol",
          "match": "#[0-9]+"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.protocol",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.protocol",
          "match": "^[a-zA-Z_][a-zA-Z0-9_]*:",
          "captures": {
            "0": {
              "name": "entity.name.label.protocol"
            }
          }
        }
      ]
    },
    "events": {
      "patterns": [
        {
          "name": "entity.name.type.event.protocol",
          "match": "\\b[A-Z_][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\b"
        }
      ]
    }
  }
}
