{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OSI Protocol Language",
  "scopeName": "source.osi",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#handlers"
    },
    {
      "include": "#variable_declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#events"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.osi",
          "match": ";.*$"
        }
      ]
    },
    "handlers": {
      "patterns": [
        {
          "name": "entity.name.function.handler.osi",
          "match": "^([A-Z][A-Z0-9_\\.]*):",
          "captures": {
            "1": {
              "name": "entity.name.function.osi"
            }
          }
        }
      ]
    },
    "variable_declaration": {
      "patterns": [
        {
          "match": "\\b(declare)\\s+(integer|buffer|string|queue)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.osi"
            },
            "2": {
              "name": "storage.type.osi"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.osi",
          "match": "\\b(goto|if|return|subprog|substart|subend)\\b"
        },
        {
          "name": "keyword.other.osi",
          "match": "\\b(declare|varset|out|delete)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "support.function.osi",
          "match": "\\b(bufferit|unbufferit|calccrc|timer|untimer|queue|clearqueue|dequeue|peek|qcount|generateup|eventdown)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.osi",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.comparison.osi",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.logical.osi",
          "match": "(&&|\\|\\|)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.osi",
          "match": "\\b(integer|buffer|string|queue)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.osi",
          "match": "\\b(sizeof|copy|pos|locguide|CurrentSystemName)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.osi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.osi",
              "match": "\\\\(n|t|r|\\\\|\" )"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.osi",
          "match": "\\b-?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.charcode.osi",
          "match": "#[0-9]+"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.osi",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.osi",
          "match": "^[a-zA-Z_][a-zA-Z0-9_]*:",
          "captures": {
            "0": {
              "name": "entity.name.label.osi"
            }
          }
        }
      ]
    },
    "events": {
      "patterns": [
        {
          "name": "entity.name.type.event.osi",
          "match": "\\b[A-Z_][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\b"
        }
      ]
    }
  }
}