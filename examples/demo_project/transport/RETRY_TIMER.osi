; ==========================================================
; RETRY_TIMER.osi
; Обработчик таймера повторной отправки
; Параметры: seq_num (integer)
; ==========================================================

RETRY_TIMER:
    out "Timeout for sequence: " $seq_num
    
    ; Увеличиваем счетчик попыток
    $retry_count + 1 varset retry_count
    
    ; Инициализируем MAX_RETRIES если нужно (эмуляция)
    3 varset MAX_RETRIES
    
    ; Проверка на превышение лимита попыток
    $retry_count >= $MAX_RETRIES if abort_connection
    
    ; Повторная отправка (используем глобальный буфер tx_buffer, предполагая, что он не изменился)
    ; В реальном протоколе буферы обычно хранятся в очереди
    N_DATA.REQ eventdown payload $tx_buffer length sizeof(tx_buffer)
    
    ; Перезапускаем таймер
    RETRY_TIMER timer retrans_timer 1000 seq_num $seq_num
    
    goto end

abort_connection:
    out "Max retries reached. Aborting connection."
    
    ; Сброс состояния
    0 varset state
    0 varset is_connected
    0 varset retry_count
    
    ; Уведомление верхнего уровня о разрыве
    DISCONNECT.IND generateup reason "Timeout"

end:
    return
