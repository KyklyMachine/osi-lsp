; Queue Example
; Demonstrates queue operations

## QUEUE_INIT
```
message_queue declare queue
pending_count declare integer

; Initialize
0 varset pending_count

out "Queue initialized"
return
```

## ADD_MESSAGE
```
message declare buffer
msg_buffer declare buffer

; Create a message
msg_buffer bufferit 10 1 1 2 2

; Add to queue
queue message_queue $msg_buffer

; Increment counter
$pending_count + 1 varset pending_count

out "Message added, queue size: " $pending_count

return
```

## PROCESS_MESSAGE
```
first_msg declare buffer
queue_size declare integer

; Get queue size
qcount(message_queue) varset queue_size

; Check if queue is empty
$queue_size == 0 if queue_empty

; Get first message without removing
peek(message_queue) varset first_msg

out "Processing message..."

; Remove and process
dequeue(message_queue) varset first_msg

; Decrement counter
$pending_count - 1 varset pending_count

out "Message processed, remaining: " $pending_count
goto exit

queue_empty:
    out "Queue is empty, nothing to process"

exit:
    return
```

## CLEAR_ALL
```
; Clear the queue
clearqueue message_queue

0 varset pending_count

out "Queue cleared"
return
```
